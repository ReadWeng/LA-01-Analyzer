# ==============================================================================
# Streamlit Secrets 範本設定檔
# 使用方式：
# 1. 本機執行：將本檔案複製為 .streamlit/secrets.toml 並填入真實金鑰
# 2. Streamlit Community Cloud：複製下列內容至 App Settings -> Secrets 欄位
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase 專案設定 (使用者登入、註冊與 Firestore 存取)
# ------------------------------------------------------------------------------
[firebase]
api_key = "YOUR_FIREBASE_WEB_API_KEY"
project_id = "lactatecloud"

# ------------------------------------------------------------------------------
# Intervals.icu OAuth 2.0 整合憑證
# 前往 Intervals.icu -> Settings -> Developer Settings 取得
# ------------------------------------------------------------------------------
[intervals]
client_id = "1038"
client_secret = "YOUR_INTERVALS_CLIENT_SECRET"
redirect_uri = ""

# ------------------------------------------------------------------------------
# Google Gemini AI 分析金鑰 (選填：用於調用 Gemini 生成深度汗乳酸教練評析)
# 前往 Google AI Studio (https://aistudio.google.com/) 取得
# 若未提供，系統將自動啟動高階離線動態生理學運算引擎
# ------------------------------------------------------------------------------
[gemini]
api_key = "YOUR_GEMINI_API_KEY"
